# Source code and selected experiment results. Other root-level files stay local.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/main.py
!/pyproject.toml
!/requirements*.txt
!/src/
!/configs/
!/scripts/
!/docs/
!/tests/
!/tool/
!/annotate/
!/examples/
!/outputs/

# Track MLLM reports, metrics and experiment metadata only.
/outputs/*
!/outputs/runs/
/outputs/runs/**
!/outputs/runs/**/
!/outputs/runs/*/*.md
!/outputs/runs/*/*.csv
!/outputs/runs/*/*.txt
!/outputs/runs/*/dataset.json
!/outputs/runs/*/prompt_results.json
!/outputs/runs/*/results_summary.json
!/outputs/runs/*/MLLM*/**/*.md
!/outputs/runs/*/MLLM*/**/*.csv
!/outputs/runs/*/MLLM*/**/*.txt
!/outputs/runs/*/MLLM*/**/metrics.json
!/outputs/runs/*/MLLM*/**/prompt.json
!/outputs/runs/*/MLLM*/**/prompt_results.json
!/outputs/runs/*/MLLM*/**/prompt_version.json
!/outputs/runs/*/MLLM*/**/config.resolved.json
!/outputs/runs/*/MLLM*/**/run.json

# Per-image outputs and JSON bundles containing raw records stay local.
# summary.json, comparison*.json and records.jsonl are excluded by default.
/outputs/runs/**/feedback/
/outputs/runs/**/predictions*/
/outputs/runs/**/visualizations/
/outputs/runs/**/.inference_cache/
/outputs/runs/**/*.lock

# Runtime assets remain local, including images, annotations and support sets.
/data/
/runs/
/weights/
/third_party/
/.venv*/
/.planning/
/task_plan.md
/findings.md
/progress.md

# Historical experiment reports are results, not deployment documentation.
/docs/*RESULTS*.md
/docs/*ANALYSIS*.md
/docs/*DIAGNOSIS*.md
/docs/*COMPARISON*.md
/docs/history/

# Machine-specific settings and credentials. Keep only the empty template.
.env
.env.*
!/.env.example
*.local.yaml
*.local.yml
*.local.json
*.local.toml
*.pem
*.key
id_rsa*
id_ed25519*
credentials.json
*.sqlite
*.sqlite3
*.db

# Generated packages, IDE state, model files and accidental binary exports.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.vscode/
.idea/
build/
dist/
*.log
*.tmp
*.part
*.pt
*.pth
*.safetensors
*.onnx
*.tflite
*.bin
*.npy
*.npz
*.zip
*.tar
*.gz
*.7z
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.mp4
*.avi
