# Code-only repository. New root-level files must be explicitly allowed.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/main.py
!/pyproject.toml
!/requirements*.txt
!/src/
!/configs/
!/scripts/
!/docs/
!/tests/
!/tool/
!/annotate/
!/examples/

# Runtime assets remain local, including images, annotations and support sets.
/data/
/outputs/
/runs/
/weights/
/third_party/
/.venv*/
/.planning/
/task_plan.md
/findings.md
/progress.md

# Historical experiment reports are results, not deployment documentation.
/docs/*RESULTS*.md
/docs/*ANALYSIS*.md
/docs/*DIAGNOSIS*.md
/docs/*COMPARISON*.md
/docs/history/

# Machine-specific settings and credentials. Keep only the empty template.
.env
.env.*
!/.env.example
*.local.yaml
*.local.yml
*.local.json
*.local.toml
*.pem
*.key
id_rsa*
id_ed25519*
credentials.json
*.sqlite
*.sqlite3
*.db

# Generated packages, IDE state, model files and accidental binary exports.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.vscode/
.idea/
build/
dist/
*.log
*.tmp
*.part
*.pt
*.pth
*.safetensors
*.onnx
*.tflite
*.bin
*.npy
*.npz
*.zip
*.tar
*.gz
*.7z
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.mp4
*.avi
