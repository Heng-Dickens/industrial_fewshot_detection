# Source code and selected experiment results. Other root-level files stay local.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/main.py
!/pyproject.toml
!/requirements*.txt
!/src/
!/configs/
!/scripts/
!/docs/
!/tests/
!/tool/
!/annotate/
!/examples/
!/outputs/

# Track reports, metrics and experiment metadata for every detector backend.
/outputs/*
!/outputs/README.md
!/outputs/runs/
/outputs/runs/**
!/outputs/runs/**/
!/outputs/runs/**/*.md
!/outputs/runs/**/*.csv
!/outputs/runs/**/*.txt
!/outputs/runs/**/dataset.json
!/outputs/runs/**/results_summary.json
!/outputs/runs/**/metrics.json
!/outputs/runs/**/prompt.json
!/outputs/runs/**/prompt_results.json
!/outputs/runs/**/prompt_version.json
!/outputs/runs/**/config.resolved.json
!/outputs/runs/**/run.json
!/outputs/runs/**/method.json
!/outputs/runs/**/experiment.json
!/outputs/runs/**/experiment_results.json

# Topic comparisons contain compact reports, indexes and diagnostic summaries.
!/outputs/comparisons/
/outputs/comparisons/**
!/outputs/comparisons/**/
!/outputs/comparisons/**/*.md
!/outputs/comparisons/**/*.csv
!/outputs/comparisons/**/*.txt
!/outputs/comparisons/**/*.json

# Per-image outputs and JSON bundles containing raw records stay local.
# summary.json, comparison*.json and records.jsonl are excluded by default.
/outputs/runs/**/feedback/
/outputs/runs/**/predictions*/
/outputs/runs/**/visualizations/
/outputs/runs/**/.inference_cache/
/outputs/runs/**/*.lock
/outputs/runs/**/runtime/
/outputs/runs/**/cache/
/outputs/runs/**/.cache/
/outputs/runs/**/logs/
/outputs/comparisons/**/records.jsonl
/outputs/comparisons/**/summary.json
/outputs/comparisons/**/predictions*/
/outputs/comparisons/**/feedback/
/outputs/comparisons/**/.inference_cache/
/outputs/comparisons/**/runtime/
/outputs/comparisons/**/cache/
/outputs/comparisons/**/.cache/
/outputs/comparisons/**/logs/

# Runtime assets remain local, including images, annotations and support sets.
/data/
/runs/
/weights/
/third_party/
/.venv*/
/.planning/
/task_plan.md
/findings.md
/progress.md

# Historical experiment reports are results, not deployment documentation.
/docs/*RESULTS*.md
/docs/*ANALYSIS*.md
/docs/*DIAGNOSIS*.md
/docs/*COMPARISON*.md
/docs/history/

# Machine-specific settings and credentials. Keep only the empty template.
.env
.env.*
!/.env.example
*.local.yaml
*.local.yml
*.local.json
*.local.toml
*.pem
*.key
id_rsa*
id_ed25519*
credentials.json
*.sqlite
*.sqlite3
*.db

# Generated packages, IDE state, model files and accidental binary exports.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.vscode/
.idea/
build/
dist/
*.log
*.tmp
*.part
*.pt
*.pth
*.safetensors
*.onnx
*.tflite
*.bin
*.npy
*.npz
*.zip
*.tar
*.gz
*.7z
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.mp4
*.avi

# Saved comparison figures are small, reviewable experiment artifacts.
!/outputs/comparisons/**/*.jpg
!/outputs/comparisons/**/*.jpeg
!/outputs/comparisons/**/*.png
!/outputs/comparisons/**/*.webp
