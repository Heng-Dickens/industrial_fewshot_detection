# Source code and selected experiment results. Other root-level files stay local.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/main.py
!/pyproject.toml
!/requirements*.txt
!/src/
!/configs/
!/scripts/
!/docs/
!/tool/
!/annotate/
!/outputs/

# Method-first experiment reports and reproducible scripts.
/outputs/*
!/outputs/README.md
!/outputs/YOLOE/
!/outputs/PET-DINO/
!/outputs/WeDetect/
!/outputs/GroundingDINO/
!/outputs/OVD-MLLM/
!/outputs/Qwen/
!/outputs/JSTY-YOLO/
!/outputs/_shared/
/outputs/**
!/outputs/**/
!/outputs/**/*.md
!/outputs/**/*.csv
!/outputs/**/*.txt
!/outputs/**/*.json
!/outputs/**/*.py
!/outputs/**/*.yaml
!/outputs/**/*.yml
/outputs/**/records.jsonl
/outputs/**/source_records.jsonl
/outputs/**/summary.json
/outputs/**/predictions*/
/outputs/**/feedback/
/outputs/**/visualizations/
/outputs/**/cache/
/outputs/**/.cache/
/outputs/**/.inference_cache/
/outputs/**/logs/
/outputs/**/*.lock
/outputs/_shared/runtime/
/outputs/_shared/cache/
/outputs/_shared/archive/
/outputs/_shared/environment_setup/
/outputs/_shared/legacy_run_runtime/

# Runtime assets remain local, including images, annotations and support sets.
/data/
/runs/
/weights/
/third_party/
/.venv*/
/.planning/
/task_plan.md
/findings.md
/progress.md

# Historical experiment reports are results, not deployment documentation.
/docs/*RESULTS*.md
/docs/*ANALYSIS*.md
/docs/*DIAGNOSIS*.md
/docs/*COMPARISON*.md
/docs/history/

# Machine-specific settings and credentials. Keep only the empty template.
.env
.env.*
!/.env.example
*.local.yaml
*.local.yml
*.local.json
*.local.toml
*.pem
*.key
id_rsa*
id_ed25519*
credentials.json
*.sqlite
*.sqlite3
*.db

# Generated packages, IDE state, model files and accidental binary exports.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.vscode/
.idea/
build/
dist/
*.log
*.tmp
*.part
*.pt
*.pth
*.safetensors
*.onnx
*.tflite
*.bin
*.npy
*.npz
*.zip
*.tar
*.gz
*.7z
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.mp4
*.avi

# Saved comparison figures are small, reviewable experiment artifacts.
!/outputs/**/comparisons/**/*.jpg
!/outputs/**/comparisons/**/*.jpeg
!/outputs/**/comparisons/**/*.png
!/outputs/**/comparisons/**/*.webp
